{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "off-air-vtuber-archive-admin",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yeojeonhi-vtuber-archive-db",
      "database_id": "7476325e-c1a2-4b36-bc27-5f2b236d3017",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PROFILE_IMAGES", "bucket_name": "yeojeonhi-profile-images" }
  ],
  "vars": {
    "DEPLOYMENT_ROLE": "admin",
    "ADMIN_EMAIL": "lununs@naver.com"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
